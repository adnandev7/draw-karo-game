{
  "name": "@drawkaro/server",
  "version": "0.0.1",
  "private": true,
  "description": "Draw Karo authoritative game server (Node + Socket.IO)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drawkaro/shared": "*",
    "@drawkaro/words": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
